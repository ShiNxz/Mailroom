# Local dev against docker-compose.dev.yml
DATABASE_URL=postgres://mailroom:mailroom@localhost:55432/mailroom
REDIS_URL=redis://localhost:56379
# openssl rand -hex 32. Encrypts mailbox passwords: changing it makes saved passwords unreadable.
APP_SECRET=
PORT=3001
# The worker needs its own port for its health endpoint when both run on one machine
# PORT=3002
LOG_LEVEL=info

# Optional: required when creating the owner account on first run
# SETUP_TOKEN=
