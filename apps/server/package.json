{
	"name": "@mailroom/server",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/api.ts",
		"worker:dev": "bun --watch src/worker.ts",
		"start": "bun src/api.ts",
		"worker": "bun src/worker.ts",
		"db:generate": "drizzle-kit generate",
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@mailroom/shared": "workspace:*",
		"drizzle-orm": "0.45.4",
		"elysia": "1.4.32",
		"imapflow": "2.12.2",
		"ioredis": "6.1.0",
		"mailparser": "3.15.0",
		"nodemailer": "10.6.1",
		"postgres": "4.1.1",
		"sanitize-html": "2.18.2"
	},
	"devDependencies": {
		"@types/bun": "1.4.5",
		"@types/mailparser": "3.9.0",
		"@types/sanitize-html": "2.16.2",
		"drizzle-kit": "0.31.11",
		"typescript": "^5.9.3"
	}
}
