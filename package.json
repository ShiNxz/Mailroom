{
	"name": "mailroom",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "bun run --filter './apps/*' dev",
		"api:dev": "bun run --cwd apps/server dev",
		"worker:dev": "bun run --cwd apps/server worker:dev",
		"web:dev": "bun run --cwd apps/web dev",
		"web:build": "bun run --cwd apps/web build",
		"db:generate": "bun run --cwd apps/server db:generate",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8"
	}
}
