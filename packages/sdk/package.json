{
	"name": "mailroom-sdk",
	"version": "0.1.0",
	"description": "Send and receive email through a Mailroom server: mailboxes, sending, replies, and live new-mail events.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md"],
	"engines": { "node": ">=18" },
	"repository": { "type": "git", "url": "git+https://github.com/ShiNxz/Mailroom.git", "directory": "packages/sdk" },
	"keywords": ["email", "mail", "imap", "smtp", "mailroom", "webhooks"],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p .",
		"prepublishOnly": "bun run build"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	}
}
